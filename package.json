{
  "name": "fab-mask",
  "version": "1.4.2",
  "private": true,
  "description": "Chrome & Edge extension that masks sensitive information in the Microsoft Fabric / Power BI portal",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "build": "node scripts/package.mjs",
    "build:signed": "CRX_KEY_PATH=${CRX_KEY_PATH:-$HOME/.config/fab-mask/fab-mask.pem} node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "lint:firefox": "npm run build && web-ext lint --source-dir dist/firefox",
    "test:e2e:firefox": "npm run build && node --test tests/e2e-firefox/*.test.js",
    "build:safari": "node scripts/build-safari.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "crx3": "^2.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.50.0",
    "puppeteer-core": "^25.12.0",
    "web-ext": "^10.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheTrustedAdvisor/fab-mask.git"
  },
  "homepage": "https://github.com/TheTrustedAdvisor/fab-mask#readme",
  "bugs": {
    "url": "https://github.com/TheTrustedAdvisor/fab-mask/issues"
  },
  "author": "Matthias Falland"
}
